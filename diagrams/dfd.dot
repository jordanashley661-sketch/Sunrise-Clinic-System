digraph G {graph [bgcolor="white",pad="0.20",nodesep="0.35",ranksep="0.48",fontname="Arial"]; node [shape=box,style="rounded,filled",fillcolor="#F2F5F8",color="#6A7987",fontname="Arial",fontsize=11,margin="0.16,0.12"]; edge [fontname="Arial",fontsize=9,color="#52636e",arrowsize=0.7];
rankdir=TB;
reception [label="Receptionist",shape=ellipse]; clinician [label="Doctor or Nurse",shape=ellipse]; admin [label="Administrator",shape=ellipse];
auth [label="1 Authenticate and authorise"];
patients [label="2 Maintain patient demographics"];
